c bougainville_2019 generated from template at 2019-10-01 02:20:24
c with name "Bougainville 2019". Modified from Bougainville 2013 © 2013, 2017, SIL PNG.
c Renamed "Bougainville" in version 1.3, with the keyboard ID changed from
c bougainville_2019 to bougainville.
store(&VERSION) '10.0'
store(&NAME) 'Bougainville'
store(&COPYRIGHT) '© 2019, SIL PNG'
store(&KEYBOARDVERSION) '1.3'
store(&TARGETS) 'any'
store(&VISUALKEYBOARD) 'bougainville.kvks'
store(&LAYOUTFILE) 'bougainville.keyman-touch-layout'
store(&BITMAP) 'B.ico'
c store(&MnemonicLayout) '1'

c *******************************************************************
store(&MESSAGE) ';+x is trigger for most sequences.'
store(&KMW_HELPTEXT) ';+x is trigger for most sequences. Vowels with macron are typed v+= . Double-macron vowels are typed e=e (E=E for all capitals). IPA phonetic characters use trigger q+x (x is trigger for ' U+0027 'u' U+0027 ' rota), with rotas for other related IPA forms. Curly quotes are RAlt+[ and RAlt+] (add Shift for double quotes), or q+< and q+> (q+<< and q+>> for double quotes), or typed in rota with the straight quotes ' U+0027 ' and ". Narrow no-break space is q+space.'
begin Unicode > use(main)

c ----------- DEADKEY TRIGGERS -----------
c ; ` ~ q x are deadkeys: the trigger shows nothing until the next key, so no
c typed character ever has to be deleted. This is what makes them work in apps
c that don't let a keyboard delete text (e.g. WhatsApp, some Linux apps).
c If the next key isn't part of a sequence, the trigger and that key are both typed.
c : is not a deadkey (a colon is often followed by Enter); ; gives every capital too.
store(trig)   ';'      '`'       '~'       'q'   'x'
store(trigdk) dk(semi) dk(grave) dk(tilde) dk(q) dk(x)
c Every printable ASCII character except the triggers themselves
store(plain) ' !"#$%&' "'" '()*+,-./0123456789:<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\]^_abcdefghijklmnoprstuvwyz{|}'

group(main) using keys

+ any(trig) > index(trigdk, 1)

c Vasui vowels & glottals (typed with the ; deadkey)
dk(semi) + 'e' > U+00EB    c ë
dk(semi) + 'o' > U+00F6    c ö
dk(semi) + 'E' > U+00CB    c Ë  works with both ';' and shifted ':' for upper case forms
dk(semi) + 'O' > U+00D6    c Ö
dk(semi) + 'c' > U+0254    c reversed c   ɔ
dk(semi) + 'C' > U+0186    c upper case open o   Ɔ
dk(semi) + 'a' > U+00E4    c ä
dk(semi) + 'A' > U+00C4    c Ä
dk(semi) + 'i' > U+00EF    c ï
dk(semi) + 'I' > U+00CF    c Ï
dk(semi) + 'u' > U+00FC    c ü
dk(semi) + 'U' > U+00DC    c Ü
dk(semi) + 'v' > U+028C    c ʌ
dk(semi) + 'V' > U+0245    c Ʌ

dk(semi) + "'" > U+02BC    c Rapoisi & Vasui curly glottal
dk(semi) + ';' > U+A78C    c Sibe straight glottal

c Buin consonants
dk(semi) + 'n' > U+014B    c lower case eng  ŋ
dk(semi) + 'N' > U+014A    c upper case eng  Ŋ

c Shifted ':' also gives the capitals. ':' stays visible, so these replace it.
':' + 'E' > U+00CB    c Ë
':' + 'O' > U+00D6    c Ö
':' + 'A' > U+00C4    c Ä
':' + 'I' > U+00CF    c Ï
':' + 'U' > U+00DC    c Ü
':' + 'V' > U+0245    c Ʌ
':' + 'C' > U+0186    c Ɔ
':' + 'N' > U+014A    c Ŋ

c New method for combining double macron
c specified this 2-step method so that '=' typed in other contexts yields normal '=';
c and single macron forms also available
c STEP 1 [V + =]  yields V with macron, precomposed
'a' + '=' > U+0101	c ā transitional forms (testing use in Petats 2/2014)
'e' + '=' > U+0113      c ē
'i' + '=' > U+012B      c ī
'o' + '=' > U+014D      c ō
'u' + '=' > U+016B      c ū
c   Uppercase forms
'A' + '=' > U+0100	c Ā transitional forms
'E' + '=' > U+0112      c Ē
'I' + '=' > U+012A      c Ī
'O' + '=' > U+014C      c Ō
'U' + '=' > U+016A      c Ū

c New method for combining double macron (uncomposed with U+035E)
c Some fonts don't look good onscreen and/or print; SIL fonts work best
c STEP 2 [macron-V + same V] yields vv with double macron (Used in Buin/Telei)
U+0101 + 'a' > 'a'  U+035E   'a'        c a͞a double-macron vowels (long line above the vv)
U+0113 + 'e' > 'e'  U+035E   'e'        c e͞e
U+012B + 'i' > U+0131  U+035E   U+0131  c ı͞ı dotless i
U+014D + 'o' > 'o'  U+035E   'o'        c o͞o
U+016B + 'u' > 'u'  U+035E   'u'        c u͞u
c   Uppercase forms
U+0100 + 'a' > 'A'  U+035E   'a'        c A͞a double-macron vowels (long line above the vv)
U+0112 + 'e' > 'E'  U+035E   'e'        c E͞e
U+012A + 'i' > 'I'  U+035E   U+0131     c I͞ı
U+014C + 'o' > 'O'  U+035E   'o'        c O͞o
U+016A + 'u' > 'U'  U+035E   'u'        c U͞u
c   All-capital forms (titles, headings)
U+0100 + 'A' > 'A'  U+035E   'A'        c A͞A
U+0112 + 'E' > 'E'  U+035E   'E'        c E͞E
U+012A + 'I' > 'I'  U+035E   'I'        c I͞I
U+014C + 'O' > 'O'  U+035E   'O'        c O͞O
U+016A + 'U' > 'U'  U+035E   'U'        c U͞U
c   Stop the phonetic i rota (U+0131 + 'i' > ɨ) firing on the end of ı͞ı / I͞ı
U+035E U+0131 + 'i' > context 'i'


c ----------- PUNCTUATION CHARACTERS -----------
c Scripture typing helps: typographical quotes & dashes
c Single keys (nothing to delete, so these work in every app):
c   RAlt+[ ‘   RAlt+] ’   RAlt+Shift+[ “   RAlt+Shift+] ”   RAlt+- –   RAlt+Shift+- —
+ [RALT K_LBRKT]        > U+2018     c ‘ open single quote
+ [RALT K_RBRKT]        > U+2019     c ’ close single quote
+ [SHIFT RALT K_LBRKT]  > U+201C     c “ open double quote
+ [SHIFT RALT K_RBRKT]  > U+201D     c ” close double quote
+ [RALT K_HYPHEN]       > U+2013     c – en dash
+ [SHIFT RALT K_HYPHEN] > U+2014     c — em dash

c q then < or > (nothing to delete, so these work in every app too):
c   q< ‘   q<< “   q> ’   q>> ”
c q< and q> wait for the next key: a second < or > gives the double quote,
c anything else gives the single quote and then that key (see fallbacks below).
dk(q) + '<'   > dk(qlt)
dk(q) + '>'   > dk(qgt)
dk(qlt) + '<' > U+201C     c “ open double quote
dk(qgt) + '>' > U+201D     c ” close double quote

c Older keying, kept for existing users. The second '<' or '>' replaces the first
c quote, so it only works in apps that let a keyboard delete text.
c you must type the second '<' or '>' without holding down Right Alt
+ [SHIFT RALT K_COMMA]  > U+2018      c [RAlt + '<'] yields open single quote
U+2018     + '<' > U+201C           c [RAlt + '<<'] yields open double quote
U+2018 ' ' + '<' > U+2018  U+2018      c to handle < <<
U+201C ' ' + '<' > U+201C  U+2018      c to handle << <

c simulated rota for curly quotes: ' > ‘ > ’  ,  " > “ > ”
"'"    + "'" > U+2018
U+2018 + "'" > U+2019
U+2019 + "'" > "'"
'"'    + '"' > U+201C
U+201C + '"' > U+201D
U+201D + '"' > '"'

c         + '>'  > U+2019
+ [SHIFT RALT K_PERIOD]  > U+2019     c [RAlt + '>'] yields close single quote, parallel to open quotes above
U+2019     + '>' > U+201D           c [RAlt + '>>'] yields close double quote
U+2019 ' ' + '>' > U+2019 U+2019       c to handle > >>
U+201D ' ' + '>' > U+201D U+2019       c to handle >> >

'-' + '-' > U+2013          c en-dash
U+2013 + '-' > U+2014       c em-dash
dk(semi)  + '-' > U+2011    c non-breaking hyphen
dk(grave) + '-' > U+00AD    c soft hyphen


c ----------- PHONETIC CHARACTERS -----------
c for phonology papers ONLY, not for orthographies
c
c 'q' triggers for most phonetic, Greek & orthog. chars, except for variations
c 'x' trigger for 'u' variants
c these cycle through variants, InKey style
c (the first step is a deadkey; each further step replaces the previous letter)

c glottal stop legacy and phonetic forms
U+02BC + "'" > U+00DF     c to enter old glottal position d223 'sharp s' ß
U+00DF + "'" > U+0294	 c phonetic glottal stop: ʔ
dk(semi) + '?' > U+0294   c phonetic glottal stop (old keying): ʔ

c Cycle through variations of a
dk(q) + 'a'  > U+0251       c phonetic or literacy  ɑ
U+0251 + 'a' > U+03B1       c type 'qaa' for alpha    α
U+03B1 + 'a' > U+00E6       c type 'qaaa' for ae  æ

c Cycle through variations of e/schwa
dk(q) + 'e'  > U+025B       c phonetic open ɛ
U+025B + 'e' > U+0259       c type 'qee' for phonetic schwa    ə
U+0259 + 'e' > U+028C       c type 'qeee' for phonetic low schwa  ʌ

c Cycle through variations of g
dk(q) + 'g'  > U+0261       c literacy g
U+0261 + 'g' > U+0263       c type 'qgg' for phonetic gamma   ɣ

c Cycle through variations of s
dk(q) + 's'  > U+03C3       c sigma (syllable node)    σ
U+03c3 + 's' > U+015F       c type 'qss' for syllabic-s  ş
U+015F + 's' > 's' U+015F   c type 'qsss' for s with dot below ṣ

c Cycle through variations of i
dk(q) + 'i'  > U+0269       c dotless ɩ, curly tail
U+0269 + 'i' > U+0131       c dotless ı, straight tail
U+0131 + 'i' > U+0268       c bar-i   ɨ

c Cycle through variations of upsilon, to avoid "qu"  combos
dk(x) + 'u'  > U+03c5       c Greek upsilon   υ  , in Lucida & Gentian
U+03c5 + 'u' > U+028a       c Latin upsilon  ʊ , for Doulos which lacks Greek chars

dk(q) + 'p' > U+03C6        c phi φ
dk(q) + 'b' > U+03B2        c beta      β
dk(q) + 'r' > U+027E        c phonetic flap 'r  with fishhook'   ɾ
dk(q) + 'o' > U+0254        c 'open o'   ɔ
dk(q) + ' ' > U+202F        c narrow no-break space (NNBSP)

c Acute-accented vowels for phonology paper
dk(grave) + 'a' > U+00E1    c á
dk(grave) + 'e' > U+00E9    c é
dk(grave) + 'i' > U+00ED    c í
dk(grave) + 'o' > U+00F3    c ó
dk(grave) + 'u' > U+00FA    c ú
dk(grave) + 'A' > U+00C1    c Á
dk(grave) + 'E' > U+00C9    c É
dk(grave) + 'I' > U+00CD    c Í
dk(grave) + 'O' > U+00D3    c Ó
dk(grave) + 'U' > U+00DA    c Ú

c Nasalized vowels (with ogonek) for phonology paper
dk(tilde) + 'a' > U+0105    c ą
dk(tilde) + 'e' > U+0119    c ę
dk(tilde) + 'i' > U+012F    c į
dk(tilde) + 'o' > U+01EB    c ǫ
dk(tilde) + 'u' > U+0173    c ų
dk(tilde) + 'A' > U+0104    c Ą
dk(tilde) + 'E' > U+0118    c Ę
dk(tilde) + 'I' > U+012E    c Į
dk(tilde) + 'O' > U+01EA    c Ǫ
dk(tilde) + 'U' > U+0172    c Ų


c ----------- DEADKEY FALLBACKS -----------
c These must stay last: any sequence above wins over them.
c A trigger followed by another trigger types the first and waits on the second.
any(trigdk) + any(trig)  > index(trig, 1) index(trigdk, 2)
c A trigger followed by any other character types both.
any(trigdk) + any(plain) > index(trig, 1) index(plain, 2)
c Backspace cancels a waiting trigger.
any(trigdk) + [K_BKSP]   > nul

c q< and q> not followed by a second < or >: type the single quote, then the key.
dk(qlt) + any(trig)  > U+2018 index(trigdk, 2)
dk(qlt) + any(plain) > U+2018 index(plain, 2)
dk(qgt) + any(trig)  > U+2019 index(trigdk, 2)
dk(qgt) + any(plain) > U+2019 index(plain, 2)
dk(qlt) + [K_BKSP]   > nul
dk(qgt) + [K_BKSP]   > nul

c EOF
